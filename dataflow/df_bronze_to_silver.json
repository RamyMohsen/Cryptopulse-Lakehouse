{
	"name": "df_bronze_to_silver",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_bronze",
						"type": "DatasetReference"
					},
					"name": "srcBronze"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "Data Lake",
						"type": "LinkedServiceReference"
					},
					"name": "sinkSilver"
				}
			],
			"transformations": [
				{
					"name": "flMarketCap"
				},
				{
					"name": "flTotalVolume"
				},
				{
					"name": "flPrices"
				},
				{
					"name": "derCleanP"
				},
				{
					"name": "derCleanMC"
				},
				{
					"name": "derCleanTV"
				},
				{
					"name": "join1"
				},
				{
					"name": "join2"
				},
				{
					"name": "selectCleanCols"
				},
				{
					"name": "arUpsert"
				}
			],
			"scriptLines": [
				"parameters{",
				"     dt as string",
				"}",
				"source(output(",
				"          coin_id as string,",
				"          market_caps as double[][],",
				"          prices as double[][],",
				"          total_volumes as double[][]",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: true,",
				"     documentForm: 'documentPerLine',",
				"     wildcardPaths:[(\"prices/*/\"+$dt+\"/prices.json\")]) ~> srcBronze",
				"srcBronze foldDown(unroll(market_caps),",
				"     mapColumn(",
				"          coin_id,",
				"          market_caps",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> flMarketCap",
				"srcBronze foldDown(unroll(total_volumes),",
				"     mapColumn(",
				"          coin_id,",
				"          total_volumes",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> flTotalVolume",
				"srcBronze foldDown(unroll(prices),",
				"     mapColumn(",
				"          coin_id,",
				"          prices",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> flPrices",
				"flPrices derive(event_date = toDate(toTimestamp(toLong(prices[1]))),",
				"          price = prices[2]) ~> derCleanP",
				"flMarketCap derive(event_date = toDate(toTimestamp(toLong(market_caps[1]))),",
				"          market_cap = market_caps[2]) ~> derCleanMC",
				"flTotalVolume derive(event_date = toDate(toTimestamp(toLong(total_volumes[1]))),",
				"          total_volume = total_volumes[2]) ~> derCleanTV",
				"derCleanP, derCleanMC join(flPrices@coin_id == flMarketCap@coin_id",
				"     && derCleanP@event_date == derCleanMC@event_date,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1, derCleanTV join(flPrices@coin_id == flTotalVolume@coin_id",
				"     && derCleanP@event_date == derCleanTV@event_date,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join2",
				"join2 select(mapColumn(",
				"          coin_id = flPrices@coin_id,",
				"          event_date = derCleanP@event_date,",
				"          price,",
				"          market_cap,",
				"          total_volume",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectCleanCols",
				"selectCleanCols alterRow(upsertIf(1==1)) ~> arUpsert",
				"arUpsert sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     fileSystem: 'silver',",
				"     folderPath: 'coin_prices',",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: false,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: false,",
				"     updateable: false,",
				"     upsertable: true,",
				"     keys:['coin_id','event_date'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sinkSilver"
			]
		}
	}
}