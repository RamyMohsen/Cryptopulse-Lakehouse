{
	"name": "pl_ingest_bronze",
	"properties": {
		"activities": [
			{
				"name": "Get Watermark",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"dataset": {
						"referenceName": "ds_watermark",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "Loop Coins",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Get Top Coins",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Get Top Coins').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Get Coin Price Range",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "RestSource",
									"httpRequestTimeout": "00:01:40",
									"requestInterval": "00.00:00:00.010",
									"requestMethod": "GET",
									"paginationRules": {
										"supportRFC5988": "true"
									}
								},
								"sink": {
									"type": "JsonSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "JsonWriteSettings"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "ds_price_range",
									"type": "DatasetReference",
									"parameters": {
										"id": {
											"value": "@item().id",
											"type": "Expression"
										},
										"from": {
											"value": "@div(\n    sub(ticks(activity('Get Watermark').output.firstRow.lastRun)\n    ,ticks('1970-01-01')),\n    10000000\n)",
											"type": "Expression"
										},
										"to": {
											"value": "@div(\n    sub(ticks(utcNow())\n    ,ticks('1970-01-01T00:00:00Z')),\n    10000000\n)",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_bronze_prices",
									"type": "DatasetReference",
									"parameters": {
										"coinId": {
											"value": "@item().id\r\n",
											"type": "Expression"
										},
										"dt": {
											"value": "@formatDateTime(utcNow(),'yyyy-MM-dd')",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			},
			{
				"name": "Update Watermark",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Loop Coins",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"additionalColumns": [
							{
								"name": "lastRun",
								"value": {
									"value": "@formatDateTime(utcNow(),'yyyy-MM-dd')",
									"type": "Expression"
								}
							}
						],
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"sink": {
						"type": "JsonSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "JsonWriteSettings"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "ds_empty",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "ds_watermark",
						"type": "DatasetReference"
					}
				]
			},
			{
				"name": "Save Top Coins",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Get Watermark",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "RestSource",
						"httpRequestTimeout": "00:01:40",
						"requestInterval": "00.00:00:00.010",
						"requestMethod": "GET",
						"paginationRules": {
							"QueryParameters.{page}": {
								"value": "RANGE:1:@{pipeline().parameters.n_pages}:1",
								"type": "Expression"
							}
						}
					},
					"sink": {
						"type": "JsonSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "JsonWriteSettings"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "ds_coin_list",
						"type": "DatasetReference",
						"parameters": {
							"vs_currency": "usd",
							"order": "market_cap_desc",
							"per_page": {
								"value": "@pipeline().parameters.per_page",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_bronze_coinlist",
						"type": "DatasetReference",
						"parameters": {
							"dt": {
								"value": "@formatDateTime(utcNow(),'yyyy-MM-dd')",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "Get Top Coins",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "Save Top Coins",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"dataset": {
						"referenceName": "ds_bronze_coinlist",
						"type": "DatasetReference",
						"parameters": {
							"dt": "@formatDateTime(utcNow(),'yyyy-MM-dd')"
						}
					},
					"firstRowOnly": false
				}
			}
		],
		"parameters": {
			"n_pages": {
				"type": "string",
				"defaultValue": "1"
			},
			"per_page": {
				"type": "string",
				"defaultValue": "10"
			}
		},
		"variables": {
			"New Watermark": {
				"type": "String"
			}
		},
		"annotations": []
	}
}