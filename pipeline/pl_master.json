{
	"name": "pl_master",
	"properties": {
		"activities": [
			{
				"name": "Execute Bronze Pipeline",
				"type": "ExecutePipeline",
				"dependsOn": [],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "pl_ingest_bronze",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"n_pages": {
							"value": "@pipeline().parameters.n_pages",
							"type": "Expression"
						},
						"per_page": {
							"value": "@pipeline().parameters.per_page",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "Execute Silver Pipeline",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "Execute Bronze Pipeline",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "pl_processing_silver",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"back_dates": {
							"value": "@pipeline().parameters.back_dates",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "Execute Gold Pipeline",
				"type": "ExecutePipeline",
