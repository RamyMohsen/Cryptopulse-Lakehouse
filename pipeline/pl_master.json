{
	"name": "pl_master",
	"properties": {
		"activities": [
			{
				"name": "Execute Bronze Pipeline",
				"type": "ExecutePipeline",
				"dependsOn": [],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "pl_ingest_bronze",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"n_pages": {
							"value": "@pipeline().parameters.n_pages",
							"type": "Expression"
						},
						"per_page": {
							"value": "@pipeline().parameters.per_page",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "Execute Silver Pipeline",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "Execute Bronze Pipeline",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "pl_processing_silver",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"back_dates": {
							"value": "@pipeline().parameters.back_dates",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "Execute Gold Pipeline",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "Execute Silver Pipeline",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "pl_agg_gold",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true
				}
			},
			{
				"name": "Notify Success",
				"type": "WebActivity",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "Execute Gold Pipeline",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": []
			},
			{
				"name": "Notify Failure",
				"type": "WebActivity",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "Execute Gold Pipeline",
						"dependencyConditions": [
							"Failed"
						]
					},
					{
						"activity": "Execute Silver Pipeline",
						"dependencyConditions": [
							"Failed"
						]
					},
					{
						"activity": "Execute Bronze Pipeline",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": []
			}
		],
		"parameters": {
			"n_pages": {
				"type": "string",
				"defaultValue": "1"
			},
			"per_page": {
				"type": "string",
				"defaultValue": "10"
			},
			"back_dates": {
				"type": "array",
				"defaultValue": []
			}
		},
		"annotations": []
	}
}