					"body": {
						"value": "{\n  \"pipelineName\": \"@{pipeline().Pipeline}\",\n  \"status\": \"Failed\",\n  \"message\": \"@{string(activity('Execute Gold Pipeline').error)}\"\n}",
						"type": "Expression"
					}
				}
			},
